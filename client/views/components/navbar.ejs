<!-- ====================================================================================
     TOPBAR / NAVBAR COMPONENT (Phong cách Sapo SaaS ERP - Clean White)
     ==================================================================================== -->
<header class="bg-white border-b border-slate-200 sticky top-0 z-30 h-14">
  <div class="h-full px-4 sm:px-6 flex items-center justify-between">
    
    <!-- 1. KHU VỰC TÌM KIẾM NHANH PHONG CÁCH SAPO [Ctrl + K] -->
    <div class="flex items-center space-x-3 flex-1">
      <div class="sapo-search-box">
        <i class="fa-solid fa-magnifying-glass sapo-search-icon"></i>
        <input 
          type="text" 
          id="globalSearchInput"
          placeholder="Tìm kiếm chức năng, vật tư, đơn hàng..." 
          class="sapo-search-input"
        >
        <span class="sapo-search-kbd">Ctrl + K</span>
      </div>
    </div>

    <!-- 2. KHU VỰC THÔNG TIN TÀI KHOẢN VÀ THAO TÁC GÓC PHẢI -->
    <div class="flex items-center space-x-4">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <!-- Thẻ thông tin nhân viên đăng nhập -->
        <div class="flex items-center space-x-3 border-r border-slate-200 pr-4">
          <!-- Avatar tròn chữ cái đầu -->
          <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xs shadow-sm">
            <%= (currentUser.hoTen ? currentUser.hoTen.trim().charAt(0) : (currentUser.username ? currentUser.username.charAt(0) : 'U')).toUpperCase() %>
          </div>

          <div class="text-left hidden sm:block">
            <div class="text-xs font-semibold text-slate-800 leading-tight">
              <%= currentUser.hoTen || currentUser.username %>
            </div>
            <div class="text-[11px] text-slate-500 flex items-center gap-1.5 mt-0.5">
              <span class="sapo-badge <%= currentUser.role === 'Admin' ? 'sapo-badge-primary' : 'sapo-badge-navy' %>">
                <%= currentUser.role %>
              </span>
              <% if (currentUser.manv) { %>
                <span class="text-slate-400 font-mono text-[10px]">(NV: <%= currentUser.manv %>)</span>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Nút Đổi mật mã nhanh -->
        <a 
          href="/auth/change-password" 
          title="Đổi mật mã tài khoản" 
          class="p-2 text-slate-400 hover:text-blue-600 hover:bg-slate-100 rounded-lg transition"
        >
          <i class="fa-solid fa-key text-sm"></i>
        </a>

        <!-- Nút Đăng xuất -->
        <form action="/auth/logout" method="POST" class="inline">
          <button 
            type="submit" 
            title="Đăng xuất khỏi hệ thống"
            class="sapo-btn btn-sapo-outline text-xs px-2.5 py-1.5 border-slate-200 hover:border-rose-300 hover:text-rose-600 transition"
          >
            <i class="fa-solid fa-right-from-bracket"></i>
            <span class="hidden md:inline">Đăng xuất</span>
          </button>
        </form>
      <% } %>
    </div>

  </div>
</header>
