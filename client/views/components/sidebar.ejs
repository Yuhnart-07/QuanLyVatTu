<!-- ====================================================================================
     SIDEBAR COMPONENT (Phong cách Sapo SaaS ERP - Dark Navy #111827)
     ==================================================================================== -->
<aside class="w-60 bg-[#111827] text-slate-300 flex flex-col justify-between flex-shrink-0 select-none shadow-xl border-r border-[#1f2937]">
  
  <div class="flex flex-col">
    <!-- 1. THƯƠNG HIỆU & LOGO PHONG CÁCH SAPO -->
    <div class="h-14 flex items-center px-4 border-b border-[#1f2937] bg-[#0b1320]">
      <a href="/employees" class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-lg bg-[#0088ff] flex items-center justify-center text-white shadow-md">
          <i class="fa-solid fa-boxes-stacked text-base"></i>
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-base tracking-wider text-white leading-none">QLVT ERP</span>
          <span class="text-[10px] text-slate-400 tracking-tight mt-0.5">Quản lý kho vật tư</span>
        </div>
      </a>
    </div>

    <!-- 2. DANH MỤC ĐIỀU HƯỚNG CHÍNH -->
    <nav class="p-3 space-y-4 overflow-y-auto max-h-[calc(100vh-110px)]">

      <!-- KHỐI 1: DANH MỤC GỐC & NHÂN SỰ -->
      <div>
        <div class="text-[10.5px] font-bold text-slate-500 uppercase tracking-wider px-3 mb-1.5">
          Danh mục gốc
        </div>
        <div class="space-y-1">
          <!-- Nhân viên -->
          <a 
            href="/employees" 
            class="flex items-center space-x-3 px-3 py-2 rounded-lg text-xs font-medium transition <%= (typeof path !== 'undefined' && path.startsWith('/employees')) ? 'bg-[#0088ff]/15 text-[#0088ff] font-semibold border-l-2 border-[#0088ff]' : 'text-slate-400 hover:text-white hover:bg-[#1f2937]' %>"
          >
            <i class="fa-solid fa-users w-4 text-center"></i>
            <span>Nhân viên</span>
          </a>

          <!-- Vật tư -->
          <a 
            href="/materials" 
            class="flex items-center space-x-3 px-3 py-2 rounded-lg text-xs font-medium transition <%= (typeof path !== 'undefined' && path.startsWith('/materials')) ? 'bg-[#0088ff]/15 text-[#0088ff] font-semibold border-l-2 border-[#0088ff]' : 'text-slate-400 hover:text-white hover:bg-[#1f2937]' %>"
          >
            <i class="fa-solid fa-box-archive w-4 text-center"></i>
            <span>Vật tư</span>
          </a>
        </div>
      </div>

      <!-- KHỐI 2: NGHIỆP VỤ NHẬP / XUẤT KHO (MASTER-DETAIL) -->
      <div>
        <div class="text-[10.5px] font-bold text-slate-500 uppercase tracking-wider px-3 mb-1.5">
          Quản lý luân chuyển
        </div>
        <div class="space-y-1">
          <!-- Đơn đặt hàng -->
          <a 
            href="/orders" 
            class="flex items-center space-x-3 px-3 py-2 rounded-lg text-xs font-medium transition <%= (typeof path !== 'undefined' && path.startsWith('/orders')) ? 'bg-[#0088ff]/15 text-[#0088ff] font-semibold border-l-2 border-[#0088ff]' : 'text-slate-400 hover:text-white hover:bg-[#1f2937]' %>"
          >
            <i class="fa-solid fa-file-invoice-dollar w-4 text-center"></i>
            <span>Đơn đặt hàng</span>
          </a>

          <!-- Phiếu nhập kho -->
          <a 
            href="/receipts" 
            class="flex items-center space-x-3 px-3 py-2 rounded-lg text-xs font-medium transition <%= (typeof path !== 'undefined' && path.startsWith('/receipts')) ? 'bg-[#0088ff]/15 text-[#0088ff] font-semibold border-l-2 border-[#0088ff]' : 'text-slate-400 hover:text-white hover:bg-[#1f2937]' %>"
          >
            <i class="fa-solid fa-truck-ramp-box w-4 text-center"></i>
            <span>Phiếu nhập kho</span>
          </a>

          <!-- Phiếu xuất kho -->
          <a 
            href="/issues" 
            class="flex items-center space-x-3 px-3 py-2 rounded-lg text-xs font-medium transition <%= (typeof path !== 'undefined' && path.startsWith('/issues')) ? 'bg-[#0088ff]/15 text-[#0088ff] font-semibold border-l-2 border-[#0088ff]' : 'text-slate-400 hover:text-white hover:bg-[#1f2937]' %>"
          >
            <i class="fa-solid fa-dolly w-4 text-center"></i>
            <span>Phiếu xuất kho</span>
          </a>
        </div>
      </div>

      <!-- KHỐI 3: BÁO CÁO & THỐNG KÊ -->
      <div>
        <div class="text-[10.5px] font-bold text-slate-500 uppercase tracking-wider px-3 mb-1.5">
          Báo cáo thống kê
        </div>
        <div class="space-y-1">
          <a 
            href="/reports" 
            class="flex items-center space-x-3 px-3 py-2 rounded-lg text-xs font-medium transition <%= (typeof path !== 'undefined' && path.startsWith('/reports')) ? 'bg-[#0088ff]/15 text-[#0088ff] font-semibold border-l-2 border-[#0088ff]' : 'text-slate-400 hover:text-white hover:bg-[#1f2937]' %>"
          >
            <i class="fa-solid fa-chart-line w-4 text-center"></i>
            <span>Báo biểu</span>
          </a>
        </div>
      </div>

      <!-- KHỐI 4: QUẢN TRỊ HỆ THỐNG (CHỈ DÀNH CHO ADMIN - BR12) -->
      <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'Admin') { %>
        <div>
          <div class="text-[10.5px] font-bold text-amber-500 uppercase tracking-wider px-3 mb-1.5 flex items-center justify-between">
            <span>Quản trị hệ thống</span>
            <i class="fa-solid fa-shield-halved text-[10px]"></i>
          </div>
          <div class="space-y-1">
            <!-- Quản lý Login -->
            <a 
              href="/admin/logins" 
              class="flex items-center space-x-3 px-3 py-2 rounded-lg text-xs font-medium transition <%= (typeof path !== 'undefined' && path.startsWith('/admin/logins')) ? 'bg-[#0088ff]/15 text-[#0088ff] font-semibold border-l-2 border-[#0088ff]' : 'text-slate-400 hover:text-white hover:bg-[#1f2937]' %>"
            >
              <i class="fa-solid fa-user-gear w-4 text-center"></i>
              <span>Quản lý Login</span>
            </a>

            <!-- Sao lưu & Phục hồi CSDL -->
            <a 
              href="/admin/backup-restore" 
              class="flex items-center space-x-3 px-3 py-2 rounded-lg text-xs font-medium transition <%= (typeof path !== 'undefined' && path.startsWith('/admin/backup')) ? 'bg-[#0088ff]/15 text-[#0088ff] font-semibold border-l-2 border-[#0088ff]' : 'text-slate-400 hover:text-white hover:bg-[#1f2937]' %>"
            >
              <i class="fa-solid fa-database w-4 text-center"></i>
              <span>Sao lưu - Phục hồi</span>
            </a>
          </div>
        </div>
      <% } %>

    </nav>
  </div>

  <!-- 3. CHÂN MENU SIDEBAR -->
  <div class="p-3 border-t border-[#1f2937] text-[11px] text-slate-500 text-center bg-[#0b1320]">
    <span>Phiên bản Clean MVC &bull; 2026</span>
  </div>

</aside>
