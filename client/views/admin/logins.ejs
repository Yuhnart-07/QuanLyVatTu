<!-- View 3.1: Form Tạo / Xóa Login -->
<!-- Tham chiếu: De.md Mục II.3.1 (Giả sử 2 vai trò Admin và Nhanvien) -->

<div class="max-w-2xl mx-auto bg-white rounded-xl shadow-sm border border-gray-100 p-6 space-y-6">
  <div class="border-b border-gray-100 pb-4">
    <h2 class="text-xl font-bold text-gray-800 flex items-center space-x-2">
      <i class="fa-solid fa-user-gear text-indigo-600"></i>
      <span>3.1 Quản Lý Tài Khoản Đăng Nhập (Tạo / Xóa Login)</span>
    </h2>
    <p class="text-xs text-gray-500 mt-1">Phân quyền trực tiếp qua SQL Server Logins và Roles: Admin / Nhanvien (Rule 04)</p>
  </div>

  <form id="createLoginForm" class="space-y-4">
    <!-- Dropdown chọn nhân viên -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Họ và tên nhân viên (kèm mã NV)</label>
      <select name="manv" required class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-indigo-500">
        <option value="">-- Chọn nhân viên để cấp tài khoản --</option>
        <% if (typeof logins !== 'undefined' && logins) { %>
          <% logins.forEach(nv => { %>
            <option value="<%= nv.MANV %>"><%= nv.HO %> <%= nv.TEN %> (Mã: <%= nv.MANV %>)</option>
          <% }) %>
        <% } %>
      </select>
    </div>

    <!-- Ô nhập Username -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">User name</label>
      <input type="text" name="username" required placeholder="Nhập tên đăng nhập SQL Server..." 
        class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-indigo-500">
    </div>

    <!-- Ô nhập Mật mã -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Mật mã</label>
      <input type="password" name="password" required placeholder="Nhập mật khẩu..." 
        class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-indigo-500">
    </div>

    <!-- Radio button chọn nhóm quyền -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Thuộc Nhóm quyền</label>
      <div class="flex space-x-6">
        <label class="inline-flex items-center">
          <input type="radio" name="role" value="Nhanvien" checked class="text-indigo-600 focus:ring-indigo-500">
          <span class="ml-2 text-sm text-gray-700">Nhân viên (Quyền thao tác nghiệp vụ)</span>
        </label>
        <label class="inline-flex items-center">
          <input type="radio" name="role" value="Admin" class="text-indigo-600 focus:ring-indigo-500">
          <span class="ml-2 text-sm text-gray-700">Admin (Toàn quyền hệ thống)</span>
        </label>
      </div>
    </div>

    <!-- Các nút lệnh chức năng -->
    <div class="flex space-x-3 pt-4 border-t border-gray-100">
      <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2 rounded-lg text-sm font-medium transition">
        Tạo username
      </button>
      <button type="button" onclick="deleteSelectedLogin()" class="bg-red-600 hover:bg-red-700 text-white px-5 py-2 rounded-lg text-sm font-medium transition">
        Xóa username
      </button>
      <a href="/employees" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-5 py-2 rounded-lg text-sm font-medium text-center transition">
        Thoát
      </a>
    </div>
  </form>
</div>
