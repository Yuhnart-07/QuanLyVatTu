<!-- View 2: Lập Các Báo Biểu (Reports) -->
<!-- Tham chiếu: De.md Mục II.2 (Báo biểu 2.1 đến 2.7) -->

<div class="space-y-6">
  <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
    <h2 class="font-bold text-gray-800 text-xl flex items-center space-x-2 mb-2">
      <i class="fa-solid fa-chart-pie text-indigo-600"></i>
      <span>HỆ THỐNG BÁO BIỂU & THỐNG KÊ (REPORTS)</span>
    </h2>
    <p class="text-sm text-gray-500">Xem và xuất các báo biểu theo đúng quy chuẩn đề tài QLVT</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- 2.1 In danh sách nhân viên -->
    <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition">
      <div class="flex items-center space-x-3 mb-3 text-indigo-600">
        <i class="fa-solid fa-print text-xl"></i>
        <h3 class="font-bold text-base text-gray-800">2.1 Danh sách nhân viên</h3>
      </div>
      <p class="text-xs text-gray-500 mb-4">Sắp xếp theo thứ tự tăng dần của Tên + Họ nhân viên.</p>
      <button onclick="loadReport('employees')" class="w-full bg-indigo-50 hover:bg-indigo-100 text-indigo-700 py-2 rounded-lg text-sm font-medium transition">
        Xem báo cáo
      </button>
    </div>

    <!-- 2.2 In danh mục vật tư -->
    <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition">
      <div class="flex items-center space-x-3 mb-3 text-indigo-600">
        <i class="fa-solid fa-boxes-packing text-xl"></i>
        <h3 class="font-bold text-base text-gray-800">2.2 Danh mục vật tư</h3>
      </div>
      <p class="text-xs text-gray-500 mb-4">Sắp xếp theo thứ tự tăng dần của Tên vật tư.</p>
      <button onclick="loadReport('materials')" class="w-full bg-indigo-50 hover:bg-indigo-100 text-indigo-700 py-2 rounded-lg text-sm font-medium transition">
        Xem báo cáo
      </button>
    </div>

    <!-- 2.3 Đơn đặt hàng chưa hoàn tất -->
    <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition">
      <div class="flex items-center space-x-3 mb-3 text-indigo-600">
        <i class="fa-solid fa-clock-rotate-left text-xl"></i>
        <h3 class="font-bold text-base text-gray-800">2.3 DDH chưa hoàn tất</h3>
      </div>
      <p class="text-xs text-gray-500 mb-4">Đơn hàng chưa có phiếu nhập hoặc chưa nhập đủ số lượng đặt.</p>
      <button onclick="loadReport('pending-orders')" class="w-full bg-indigo-50 hover:bg-indigo-100 text-indigo-700 py-2 rounded-lg text-sm font-medium transition">
        Xem báo cáo
      </button>
    </div>

    <!-- 2.4 Bảng kê chi tiết nhập/xuất -->
    <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition">
      <div class="flex items-center space-x-3 mb-3 text-indigo-600">
        <i class="fa-solid fa-table-list text-xl"></i>
        <h3 class="font-bold text-base text-gray-800">2.4 Chi tiết Nhập / Xuất</h3>
      </div>
      <p class="text-xs text-gray-500 mb-4">Bảng kê chi tiết SL - trị giá hàng nhập/xuất theo tháng.</p>
      <button onclick="openDateRangeReportModal('detail-in-out')" class="w-full bg-indigo-50 hover:bg-indigo-100 text-indigo-700 py-2 rounded-lg text-sm font-medium transition">
        Chọn khoảng thời gian
      </button>
    </div>

    <!-- 2.5 & 2.6 Thống kê theo năm -->
    <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition">
      <div class="flex items-center space-x-3 mb-3 text-indigo-600">
        <i class="fa-solid fa-calendar-days text-xl"></i>
        <h3 class="font-bold text-base text-gray-800">2.5 & 2.6 Thống kê theo năm</h3>
      </div>
      <p class="text-xs text-gray-500 mb-4">Thống kê số lượng phiếu và tổng trị giá từng tháng trong năm.</p>
      <button onclick="openYearReportModal()" class="w-full bg-indigo-50 hover:bg-indigo-100 text-indigo-700 py-2 rounded-lg text-sm font-medium transition">
        Chọn năm thống kê
      </button>
    </div>

    <!-- 2.7 BẢNG TỔNG HỢP NHẬP XUẤT -->
    <div class="bg-white p-5 rounded-xl shadow-sm border border-indigo-200 bg-indigo-50/30 hover:shadow-md transition">
      <div class="flex items-center space-x-3 mb-3 text-indigo-700">
        <i class="fa-solid fa-file-invoice text-xl"></i>
        <h3 class="font-bold text-base text-gray-900">2.7 Bảng Tổng Hợp Nhập Xuất</h3>
      </div>
      <p class="text-xs text-gray-500 mb-4">Tổng hợp số tiền Nhập, Xuất và tỷ lệ % theo từng ngày.</p>
      <button onclick="openDateRangeReportModal('summary-in-out')" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-2 rounded-lg text-sm font-medium transition">
        Xem báo cáo tổng hợp
      </button>
    </div>
  </div>

  <!-- Khu vực hiển thị bảng kết quả báo biểu -->
  <div id="reportResultContainer" class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hidden">
    <div class="flex justify-between items-center mb-4">
      <h3 id="reportTitle" class="font-bold text-lg text-gray-800">Kết Quả Báo Cáo</h3>
      <button onclick="printReport()" class="bg-gray-100 hover:bg-gray-200 px-3 py-1.5 rounded text-xs font-semibold text-gray-700">
        <i class="fa-solid fa-print"></i> In / Xuất PDF
      </button>
    </div>
    <div id="reportContent" class="overflow-x-auto">
      <!-- Dữ liệu báo cáo động -->
    </div>
  </div>
</div>
