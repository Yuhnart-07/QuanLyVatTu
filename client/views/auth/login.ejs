<!-- View Đăng nhập (Login) -->
<div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-8 border border-gray-100">
  <div class="text-center mb-8">
    <div class="inline-flex p-3 bg-indigo-100 text-indigo-600 rounded-full mb-3">
      <i class="fa-solid fa-boxes-stacked text-3xl"></i>
    </div>
    <h2 class="text-2xl font-bold text-gray-900">ĐĂNG NHẬP HỆ THỐNG</h2>
    <p class="text-sm text-gray-500 mt-1">Phần mềm Quản lý Nhập/Xuất Vật Tư</p>
  </div>

  <form action="/auth/login" method="POST" class="space-y-5">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Tên đăng nhập (SQL Server Login)</label>
      <div class="relative">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
          <i class="fa-solid fa-user"></i>
        </span>
        <input type="text" name="username" required placeholder="Nhập username..." 
          class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Mật mã</label>
      <div class="relative">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
          <i class="fa-solid fa-lock"></i>
        </span>
        <input type="password" name="password" required placeholder="Nhập mật khẩu..." 
          class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm">
      </div>
    </div>

    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-lg shadow transition duration-150 flex items-center justify-center space-x-2">
      <i class="fa-solid fa-right-to-bracket"></i>
      <span>Đăng Nhập</span>
    </button>
  </form>

  <div class="mt-6 text-center text-xs text-gray-400">
    Hệ thống xác thực trực tiếp qua SQL Server Security (Rule 04)
  </div>
</div>
